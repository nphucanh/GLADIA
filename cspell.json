{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules",
    "dist",
    ".cache",
    "package-lock.json",
    "*.tsbuildinfo",
    "src/data/maps/**",
    "supabase/seed.sql"
  ],
  "ignoreRegExpList": [
    "vietnamese-diacritics"
  ],
  "patterns": [
    {
      "name": "vietnamese-diacritics",
      "description": "Từ tiếng Việt có dấu (chú thích, nội dung) — không kiểm tra chính tả tiếng Anh",
      "pattern": "/[A-Za-z]*[À-ÃÈ-ÊÌÍÒ-ÕÙÚÝà-ãè-êìíò-õùúýĂăĐđĨĩŨũƠơƯưẠ-ỹ][A-Za-zÀ-ÃÈ-ÊÌÍÒ-ÕÙÚÝà-ãè-êìíò-õùúýĂăĐđĨĩŨũƠơƯưẠ-ỹ]*/gu"
    }
  ],
