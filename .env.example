# Lấy 2 giá trị này ở Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Captcha trang đăng nhập quản trị (Cloudflare Turnstile) — SITE KEY công khai, để trống = không dùng captcha.
# Secret key KHÔNG để ở đây: dán vào Supabase > Authentication > Attack Protection > CAPTCHA.
VITE_TURNSTILE_SITE_KEY=

# (Tuỳ chọn, chỉ dùng trên máy lập trình) Chuỗi kết nối database để tự đồng bộ supabase/schema.sql:
#   npm run dev / npm run db:push / npm run db:watch — xem scripts/db/schema-sync.mjs
# Lấy ở Project Settings > Database > Connection string > "Session pooler". CÓ MẬT KHẨU → không commit,
# không thêm tiền tố VITE_ (biến VITE_ bị đóng gói vào website).
# SUPABASE_DB_URL=postgresql://postgres.xxxxx:mat-khau@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
